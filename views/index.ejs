<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>


<body>
    <nav>
        <a href="/">HOME</a>
        <a href="/about">ABOUT</a>
        <a href="/contact">CONTACT</a>
    </nav>

    <% if(blogs.length) { %>
        <% blogs.forEach(blog => {  %>
            <h2 ><%= blog.title %></h2>
            <h3><%= blog.snippet %> ... </h3>
            <br><hr>
        <% }) %>
    <% } else { %>
        <h2>no blog found</h2>
    <% } %>

    <p>this is html file</p>


    
</body>
</html>